<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="Settings"
            app:titleTextColor="@color/text_white"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_white"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ══════════════════════════════════════ -->
            <!-- PROFILE HEADER CARD                    -->
            <!-- ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_user_placeholder"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_background"
                        android:contentDescription="Profile picture"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User Name"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="user@example.com"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tvVerificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not verified"
                            android:textSize="12sp"
                            android:textColor="@color/warning"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- ACCOUNT SECTION                        -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Edit Profile -->
                    <LinearLayout
                        android:id="@+id/btnEditProfile"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_edit" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Edit Profile"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Change Password -->
                    <LinearLayout
                        android:id="@+id/btnChangePassword"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_lock" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Change Password"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Verify Email -->
                    <LinearLayout
                        android:id="@+id/btnVerifyEmail"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_email" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Verify Email"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Saved Jobs -->
                    <LinearLayout
                        android:id="@+id/btnSavedJobs"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_bookmark" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Saved Jobs"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- My Applications -->
                    <LinearLayout
                        android:id="@+id/btnMyApplications"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_application" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="My Applications"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- NOTIFICATIONS SECTION                  -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- All Notifications -->
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_notification" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Push Notifications"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Job Alerts -->
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_work" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Job Alerts"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchJobAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Message Notifications -->
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_message" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Message Notifications"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchMessageNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- APPEARANCE SECTION                     -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Dark Mode -->
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_dark_mode" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Dark Mode"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- PRIVACY SECTION                        -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Online Status toggle -->
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_online" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Show Online Status"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchOnlineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Profile Visibility -->
                    <LinearLayout
                        android:id="@+id/btnPrivacyProfile"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_visibility" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Who Can See My Profile"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Blocked Users -->
                    <LinearLayout
                        android:id="@+id/btnBlockedUsers"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_block" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Blocked Users"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- SUPPORT SECTION                        -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Support"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Help & Support -->
                    <LinearLayout
                        android:id="@+id/btnHelpSupport"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_help" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Help &amp; Support"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Terms -->
                    <LinearLayout
                        android:id="@+id/btnTerms"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_document" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Terms &amp; Conditions"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- Privacy Policy -->
                    <LinearLayout
                        android:id="@+id/btnPrivacyPolicy"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_shield" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="Privacy Policy"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <!-- About -->
                    <LinearLayout
                        android:id="@+id/btnAbout"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_info" app:tint="@color/primary"/>
                        <TextView style="@style/SettingsRowText" android:text="About JobLinker"/>
                        <ImageView style="@style/SettingsRowChevron"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- LOGOUT BUTTON                          -->
            <!-- ══════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Log Out"
                android:textColor="@color/error"
                android:textSize="16sp"
                app:strokeColor="@color/error"
                app:strokeWidth="2dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/error"/>

            <!-- ══════════════════════════════════════ -->
            <!-- DANGER ZONE                            -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️  Danger Zone"
                android:textSize="12sp"
                android:textColor="@color/error"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/btnDeleteAccount"
                        style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_delete" app:tint="@color/error"/>
                        <TextView
                            style="@style/SettingsRowText"
                            android:text="Delete Account"
                            android:textColor="@color/error"/>
                        <ImageView style="@style/SettingsRowChevron" app:tint="@color/error"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
