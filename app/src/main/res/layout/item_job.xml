<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding">

        <!-- Company Logo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_company_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_company_placeholder"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars"/>

        <!-- Urgent badge -->
        <TextView
            android:id="@+id/tv_urgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Urgent"
            android:textSize="10sp"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_rounded_primary"
            android:backgroundTint="#FF5722"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/iv_company_logo"
            app:layout_constraintTop_toBottomOf="@id/iv_company_logo"
            android:layout_marginTop="4dp"/>

        <!-- Job Title -->
        <TextView
            android:id="@+id/tv_job_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_small"
            style="@style/TextAppearance.JobLinker.HeadlineSmall"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/iv_company_logo"
            app:layout_constraintEnd_toStartOf="@id/btn_save"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Senior Software Engineer"/>

        <!-- Company Name -->
        <TextView
            android:id="@+id/tv_company_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/TextAppearance.JobLinker.BodyMedium"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/tv_job_title"
            app:layout_constraintEnd_toEndOf="@id/tv_job_title"
            app:layout_constraintTop_toBottomOf="@id/tv_job_title"
            tools:text="Google Inc."/>

        <!-- Location row -->
        <ImageView
            android:id="@+id/ic_location"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_location"
            android:contentDescription="@string/country"
            app:tint="@color/text_hint"
            app:layout_constraintStart_toStartOf="@id/tv_job_title"
            app:layout_constraintTop_toBottomOf="@id/tv_company_name"/>

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/TextAppearance.JobLinker.LabelSmall"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ic_location"
            app:layout_constraintEnd_toEndOf="@id/tv_job_title"
            app:layout_constraintTop_toTopOf="@id/ic_location"
            app:layout_constraintBottom_toBottomOf="@id/ic_location"
            tools:text="San Francisco, CA"/>

        <!-- Save Button -->
        <ImageButton
            android:id="@+id/btn_save"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bookmark_border"
            android:contentDescription="@string/save"
            app:tint="@color/secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/ic_location"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Salary -->
        <TextView
            android:id="@+id/tv_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/TextAppearance.JobLinker.BodyLarge"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:text="$120k - $180k"/>

        <!-- Category Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_category"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/surface_dark"
            app:chipMinHeight="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_salary"
            tools:text="Technology"/>

        <!-- Job Type Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_job_type"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/surface_dark"
            app:chipMinHeight="28dp"
            app:layout_constraintStart_toEndOf="@id/chip_category"
            app:layout_constraintTop_toTopOf="@id/chip_category"
            app:layout_constraintBottom_toBottomOf="@id/chip_category"
            tools:text="Full-time"/>

        <!-- Remote chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_remote"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:text="🌐 Remote"
            android:visibility="gone"
            app:chipBackgroundColor="#E8F5E9"
            app:chipMinHeight="28dp"
            app:layout_constraintStart_toEndOf="@id/chip_job_type"
            app:layout_constraintTop_toTopOf="@id/chip_category"
            app:layout_constraintBottom_toBottomOf="@id/chip_category"/>

        <!-- Posted time + applicant count -->
        <TextView
            android:id="@+id/tv_posted_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.JobLinker.LabelSmall"
            android:textColor="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chip_category"
            app:layout_constraintBottom_toBottomOf="@id/chip_category"
            tools:text="2d ago · 12 applied"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
